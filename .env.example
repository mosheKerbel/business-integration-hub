# Copy to .env for local development: cp .env.example .env

# Hub PostgreSQL (separate from Mock ERP SQLite — added in later tasks)
# BIH_POSTGRES_PORT must match the host port in DATABASE_URL (default 15432).
BIH_POSTGRES_PORT=15432
DATABASE_URL=postgresql://bih:bih@localhost:15432/bih_hub

# API process
API_HOST=127.0.0.1
API_PORT=3000

# Worker process
WORKER_POLL_INTERVAL_MS=5000

NODE_ENV=development
LOG_LEVEL=info
